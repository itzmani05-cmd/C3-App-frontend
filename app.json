{
  "expo": {
    "name": "C³ Platform",
    "slug": "c3-institute",
    "version": "2.0.0",
    "icon": "./assets/C3AppLogo.png",
    "scheme": "c3app",
    "android": {
      "package": "com.c3institute.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.c3institute.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "API_URL": "https://c3-app-backend-2.onrender.com",
      "eas": {
        "projectId": "1595038e-2d1a-4827-9cfe-04079faedab6"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to add images to questions.",
          "cameraPermission": "Allow the app to use the camera for question images."
        }
      ]
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/1595038e-2d1a-4827-9cfe-04079faedab6"
    }
  }
}
