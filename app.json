{
  "expo": {
    "name": "C³ EP",
    "slug": "c3-institute",
    "version": "2.0.0",
    "icon": "./assets/C3AppLogo.png",
    "scheme": "c3app",
    "android": {
      "package": "com.c3institute.app",
      "googleServicesFile": "./google-services.json",
      "versionCode": 2,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.c3institute.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "API_URL": "https://c3-app-backend-3.onrender.com",
      "eas": {
        "projectId": "88529227-82c2-4fe7-854a-fbfed1a9c8ac"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/C3AppLogo.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1426",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow C3 Institute to use Face ID to unlock the app."
        }
      ],
      "expo-status-bar",
      "expo-secure-store"
    ],
    "runtimeVersion": "1.0.1",
    "updates": {
      "url": "https://u.expo.dev/88529227-82c2-4fe7-854a-fbfed1a9c8ac"
    },
    "owner": "manikandan005"
  }
}
